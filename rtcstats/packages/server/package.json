{
  "name": "@rtcstats/server",
  "version": "0.0.0",
  "description": "RTCStats event log processor and feature extractors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:golden": "vitest run test/processor.golden.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rtcstats/core": "workspace:*",
    "rtcscore": "^0.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
